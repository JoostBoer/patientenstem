<%- include('partials/head', { title: instelling.naam }) %>

<section class="page-head">
  <div class="container">
    <p class="crumbs"><a href="<%= url('/') %>">← <%= t('instelling.terug') %></a></p>
    <h1 class="page-title"><%= instelling.naam %></h1>
    <p class="page-meta">
      <% if (instelling.plaats) { %><span><%= instelling.plaats %></span><% } %>
      <% if (instelling.type) { %><span class="dot">·</span><span><%= instelling.type %></span><% } %>
      <% if (instelling.aanbieder && instelling.aanbieder !== instelling.naam) { %>
        <span class="dot">·</span><span><%= t('home.onderdeel_van', { naam: instelling.aanbieder }) %></span>
      <% } %>
    </p>
    <% if (instelling.beschrijving) { %>
      <p class="page-lead"><%= instelling.beschrijving %></p>
    <% } %>

    <div class="page-summary">
      <% if (reviews.length > 0) { %>
        <span class="rating-large">★ <%= gemiddelde %></span>
        <span class="muted"><%= reviews.length === 1 ? t('home.kaart_aantal_een') : t('home.kaart_aantal_meer', { n: reviews.length }) %></span>
        <a href="<%= url('/instelling/' + instelling.slug + '/schrijven') %>" class="btn btn-primary"><%= t('instelling.schrijf_knop') %></a>
      <% } %>
    </div>
  </div>
</section>

<% if (posted) { %>
  <div class="container">
    <div class="banner banner-success">
      <%= t('instelling.geplaatst_banner') %>
    </div>
  </div>
<% } %>

<section class="reviews">
  <div class="container">
    <% if (reviews.length === 0) { %>
      <div class="leeg">
        <p><%= t('instelling.geen_ervaringen_titel', { naam: instelling.naam }) %></p>
        <p class="muted"><%= t('instelling.geen_ervaringen_sub') %></p>
        <p><a href="<%= url('/instelling/' + instelling.slug + '/schrijven') %>" class="btn btn-primary"><%= t('instelling.schrijf_knop') %></a></p>
      </div>
    <% } else { %>
      <ul class="review-lijst">
        <% reviews.forEach(function(r) { %>
          <li class="review">
            <div class="review-head">
              <span class="rating">★ <%= r.rating %></span>
              <% if (r.titel) { %><h3 class="review-titel"><%= r.titel %></h3><% } %>
            </div>
            <% if (r.rol || r.periode) { %>
              <p class="review-meta">
                <% if (r.rol) { %><span><%= r.rol %></span><% } %>
                <% if (r.rol && r.periode) { %><span class="dot">·</span><% } %>
                <% if (r.periode) { %><span><%= r.periode %></span><% } %>
              </p>
            <% } %>
            <div class="review-body">
              <% r.ervaring.split(/\n\n+/).forEach(function(p) { %>
                <p><%= p %></p>
              <% }); %>
            </div>
            <p class="review-foot muted">
              <time datetime="<%= r.created_at %>"><%= r.created_at.slice(0, 10) %></time>
            </p>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
