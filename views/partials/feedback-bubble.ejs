<div class="feedback-bubble" id="feedbackBubble">
  <button type="button" class="bubble-btn" id="bubbleOpen" aria-label="<%= t('feedback.bubble_aria') %>">
    <span class="bubble-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
    </span>
    <span class="bubble-text"><%= t('feedback.bubble_label') %></span>
  </button>

  <div class="bubble-modal" id="bubbleModal" role="dialog" aria-modal="true" aria-labelledby="bubbleTitle" hidden>
    <div class="bubble-modal-inner">
      <div class="bubble-modal-head">
        <h3 id="bubbleTitle"><%= t('feedback.modal_titel') %></h3>
        <button type="button" class="bubble-close" id="bubbleClose" aria-label="Sluiten">×</button>
      </div>
      <p class="bubble-lead"><%= t('feedback.modal_lead') %></p>
      <form id="bubbleForm">
        <div class="bubble-input-wrap">
          <textarea name="bericht" id="bubbleTekst" rows="4" maxlength="4000" placeholder="<%= t('feedback.tekst_placeholder') %>"></textarea>
          <button type="button" class="mic-btn" data-target="bubbleTekst" data-lang="<%= locale %>" aria-label="<%= t('nieuw.mic_start') %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
          </button>
        </div>
        <div class="bubble-actions">
          <button type="submit" class="btn btn-primary"><%= t('feedback.submit') %></button>
          <span class="bubble-status" id="bubbleStatus" aria-live="polite"></span>
        </div>
      </form>
    </div>
  </div>
</div>
