<%- include('partials/head', { title: t('melden.page_titel') }) %>

<section class="page-head">
  <div class="container narrow">
    <p class="crumbs"><a href="<%= url('/instelling/' + instelling.slug) %>">← <%= instelling.naam %></a></p>
    <h1 class="page-title"><%= t('melden.page_titel') %></h1>
    <% if (gemeld) { %>
      <div class="banner banner-success"><%= t('melden.gemeld') %></div>
      <p><a href="<%= url('/instelling/' + instelling.slug) %>" class="btn btn-link"><%= t('melden.terug_link', { naam: instelling.naam }) %></a></p>
    <% } else { %>
      <p class="page-lead"><%= t('melden.page_lead') %></p>
    <% } %>
  </div>
</section>

<% if (!gemeld) { %>
<section class="form-sectie">
  <div class="container narrow">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="banner banner-error"><%= error %></div>
    <% } %>
    <form method="post" action="<%= url('/review/' + review.id + '/melden') %>" class="form">
      <div class="veld">
        <label for="reden" class="veld-label"><%= t('melden.reden_label') %> <span class="vereist">*</span></label>
        <textarea id="reden" name="reden" rows="6" required minlength="10" maxlength="2000"></textarea>
      </div>
      <div class="veld">
        <label for="contact_email" class="veld-label"><%= t('melden.email_label') %> <span class="muted"><%= t('melden.email_optioneel') %></span></label>
        <input type="email" id="contact_email" name="contact_email" maxlength="200">
        <p class="veld-hint"><%= t('melden.email_hint') %></p>
      </div>
      <div class="acties">
        <button type="submit" class="btn btn-primary"><%= t('melden.submit') %></button>
        <a href="<%= url('/instelling/' + instelling.slug) %>" class="btn btn-link"><%= t('melden.annuleer') %></a>
      </div>
    </form>
  </div>
</section>
<% } %>

<%- include('partials/foot') %>
